# Public deploy: NO server key usage — visitors bring their own key.
# Paste key in the app's "AI" settings, or Sign in with OpenRouter (PKCE).

# Local-only escape hatch — never set this on a public host:
# QUIZ_ALLOW_SERVER_KEY=1
# QUIZ_BASE_URL=https://api.groq.com/openai/v1
# QUIZ_API_KEY=
# QUIZ_MODEL=openai/gpt-oss-120b

# Or local OpenRouter:
# QUIZ_ALLOW_SERVER_KEY=1
# QUIZ_BASE_URL=https://openrouter.ai/api/v1
# QUIZ_API_KEY=$OPENROUTER_API_KEY
# QUIZ_MODEL=openai/gpt-4o-mini
